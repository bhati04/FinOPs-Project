# Copy to .env for local overrides. Values below are local-development only.
CLOUDWISE_ENVIRONMENT=local
CLOUDWISE_LOG_LEVEL=INFO
CLOUDWISE_DATABASE_URL=postgresql+asyncpg://cloudwise:cloudwise@postgres:5432/cloudwise
CLOUDWISE_REDIS_URL=redis://redis:6379/0
CLOUDWISE_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
CLOUDWISE_API_REQUEST_MAX_BYTES=1048576
CLOUDWISE_AUTH_SECRET_KEY=local-only-change-before-production-0123456789abcdef0123456789abcdef
CLOUDWISE_ACCESS_TOKEN_MINUTES=15
CLOUDWISE_REFRESH_TOKEN_DAYS=7
CLOUDWISE_EXTERNAL_ID_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Optional Cost Explorer grouping. The matching AWS cost-allocation tag must be active.
CLOUDWISE_COST_ALLOCATION_TAG_KEY=

# Recommendation pricing. Use aws in staging/production; mock is local-only.
CLOUDWISE_RECOMMENDATION_PRICING_PROVIDER=mock
CLOUDWISE_RECOMMENDATION_PRICING_ENDPOINT_REGION=us-east-1
CLOUDWISE_RECOMMENDATION_PRICING_STALE_HOURS=48

# Reports and notifications. Production requires S3; SES is opt-in.
CLOUDWISE_REPORT_STORAGE_PROVIDER=local
CLOUDWISE_REPORT_LOCAL_DIRECTORY=/var/lib/cloudwise/reports
CLOUDWISE_REPORT_S3_BUCKET=
CLOUDWISE_REPORT_S3_PREFIX=cloudwise-reports
CLOUDWISE_REPORT_RETENTION_DAYS=30
CLOUDWISE_NOTIFICATION_PROVIDER=disabled
CLOUDWISE_NOTIFICATION_SES_REGION=us-east-1
CLOUDWISE_NOTIFICATION_FROM_EMAIL=

# On-demand explanation only. Keep disabled until authenticated recommendation
# routes exist and the EC2 role has least-privilege Bedrock access.
CLOUDWISE_AI_ADVISOR_ENABLED=false
CLOUDWISE_AI_ADVISOR_PROVIDER=bedrock
CLOUDWISE_AI_ADVISOR_MODEL_ID=
CLOUDWISE_AI_ADVISOR_AWS_REGION=us-east-1
CLOUDWISE_AI_ADVISOR_MAX_OUTPUT_TOKENS=800
CLOUDWISE_AI_ADVISOR_TIMEOUT_SECONDS=20

POSTGRES_DB=cloudwise
POSTGRES_USER=cloudwise
POSTGRES_PASSWORD=cloudwise

VITE_API_BASE_URL=http://localhost:8000/api/v1
